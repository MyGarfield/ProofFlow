{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proofflow/evaluation-report.schema.json",
  "title": "ProofFlow evaluation protocol validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_status",
    "execution_claim",
    "protocol_manifest_sha256",
    "arms",
    "scorecard",
    "metric_contract",
    "provenance",
    "report_hash"
  ],
  "properties": {
    "schema_version": {"const": "proofflow.evaluation-report/v1"},
    "report_status": {"const": "PROTOCOL_VALIDATED_NOT_EXECUTED"},
    "execution_claim": {"const": "NONE"},
    "protocol_manifest_sha256": {"$ref": "#/$defs/digest"},
    "arms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm_id", "execution_status", "score_status", "gate_status", "reason_codes"],
        "properties": {
          "arm_id": {"enum": ["deterministic_reference", "single_agent", "six_agent"]},
          "execution_status": {"const": "NOT_EXECUTED"},
          "score_status": {"const": "UNKNOWN"},
          "gate_status": {"enum": ["NOT_REQUIRED", "BLOCKED"]},
          "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}}
        }
      }
    },
    "scorecard": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["score_id", "official_weight_points", "status", "points", "reason_code"],
        "properties": {
          "score_id": {"type": "string", "minLength": 1},
          "official_weight_points": {"type": "integer", "minimum": 1},
          "status": {"const": "UNKNOWN"},
          "points": {"type": "null"},
          "reason_code": {"const": "ARM_NOT_EXECUTED"}
        }
      }
    },
    "metric_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_unit", "cost_units", "unknown_cost_representation", "reliability_denominator"],
      "properties": {
        "latency_unit": {"const": "milliseconds"},
        "cost_units": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unknown_cost_representation": {"const": "UNKNOWN_NOT_ZERO"},
        "reliability_denominator": {"const": "attempted_runs"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_schema_sha256", "worker_evidence_schema_sha256", "suite_source_sha256"],
      "properties": {
        "scenario_schema_sha256": {"$ref": "#/$defs/digest"},
        "worker_evidence_schema_sha256": {"$ref": "#/$defs/digest"},
        "suite_source_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "report_hash": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
