{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proofflow/evaluation-fixture-manifest.schema.json",
  "title": "ProofFlow public synthetic evaluation fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "fixture_id",
    "data_classification",
    "base_case_manifest_path",
    "base_case_manifest_sha256",
    "documents",
    "scenario_bindings",
    "provenance",
    "limitations"
  ],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "schema_version": {"const": "proofflow.evaluation-fixture/v1"},
    "fixture_id": {"const": "proofflow-public-synthetic-001"},
    "data_classification": {"const": "PUBLIC_SYNTHETIC"},
    "base_case_manifest_path": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.json$"
    },
    "base_case_manifest_sha256": {"$ref": "#/$defs/digest"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "path", "media_type", "sha256"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.json$"
          },
          "media_type": {"const": "application/json"},
          "sha256": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "scenario_bindings": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "source_case_id", "mutation_id"],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "source_case_id": {"const": "case-happy-001"},
          "mutation_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "generator", "generator_version", "content_scope", "is_signature"],
      "properties": {
        "repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generator": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "content_scope": {"type": "string", "minLength": 1},
        "is_signature": {"const": false}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
