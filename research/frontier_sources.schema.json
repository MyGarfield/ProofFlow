{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyGarfield/ProofFlow/blob/feature/frontier-champion-research/research/frontier_sources.schema.json",
  "title": "ProofFlow frontier research source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "research_id", "accessed_at", "claims", "sources"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "schema_version": {"const": "proofflow.frontier-sources/v1"},
    "research_id": {"const": "frontier-champion-research-2026-08-20"},
    "accessed_at": {"const": "2026-08-20"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "layer", "statement"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^CL-[A-Z0-9_-]+$"},
          "layer": {
            "enum": [
              "VERIFIED_FACT",
              "TESTABLE_HYPOTHESIS",
              "NO_EVIDENCE",
              "STRONGEST_OBJECTION"
            ]
          },
          "statement": {"type": "string", "minLength": 1},
          "official_score_dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "scene_value_and_reproducibility",
                "multi_agent_collaboration_loop",
                "skill_engineering_and_reuse",
                "engineering_runtime_and_security_audit",
                "open_source"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "title",
          "publisher",
          "published_at",
          "url",
          "supports",
          "limitations",
          "accessed_at"
        ],
        "properties": {
          "source_id": {"type": "string", "pattern": "^FR-[0-9]{3}$"},
          "source_type": {
            "enum": [
              "OFFICIAL_COMPETITION_PAGE",
              "OFFICIAL_COMPETITION_MANUAL",
              "OFFICIAL_DOCS",
              "OFFICIAL_SPEC",
              "OFFICIAL_REPO",
              "OFFICIAL_PROJECT_DOCS",
              "PAPER"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "published_at": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
            ]
          },
          "url": {"type": "string", "format": "uri", "pattern": "^https://[^\\s]+$"},
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^CL-[A-Z0-9_-]+$"},
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "accessed_at": {"const": "2026-08-20"}
        }
      }
    }
  }
}
