{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proofflow.reference-runtime-evidence-video.manifest.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actual_duration_seconds",
    "artifact_hashes",
    "audio",
    "audio_role",
    "capture",
    "claims",
    "classification",
    "duration_seconds",
    "external_side_effects_enabled",
    "faststart",
    "ffprobe",
    "fps",
    "keyframe_probes",
    "ledgers",
    "lint_summary",
    "llm",
    "moov_atom_before_mdat",
    "network_ledger_non_loopback_requests_sent",
    "network_policy",
    "pixel_format",
    "readyWorkers",
    "recorded_source_commit",
    "render_input_digest",
    "render_input_hashes",
    "render_method",
    "resolution",
    "sequence",
    "source_url",
    "status",
    "subtitles",
    "video",
    "voiceover_status",
    "workers"
  ],
  "properties": {
    "schema": {"const": "proofflow.reference-runtime-evidence-video.manifest.v2"},
    "status": {"const": "REFERENCE_RUNTIME_EVIDENCE_ONLY"},
    "recorded_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actual_duration_seconds": {"const": 92.0},
    "duration_seconds": {"const": 92},
    "network_ledger_non_loopback_requests_sent": {"const": 0},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DESIGN.md",
        "SCRIPT.md",
        "STORYBOARD.md",
        "index.html",
        "subtitles.srt",
        "silent-aac.m4a",
        "renders/reference-runtime-evidence.mp4",
        "capture/meta.json",
        "capture/extracted/animations.json",
        "capture/extracted/design-styles.json",
        "capture/extracted/fonts-manifest.json",
        "capture/extracted/page.html",
        "capture/extracted/tokens.json",
        "capture/extracted/visible-text.txt",
        "capture/screenshots/full-page.png",
        "capture/screenshots/scroll-000.png",
        "evidence/action-ledger.json",
        "evidence/network-ledger.json",
        "evidence/dom-states.json",
        "evidence/capture_sequence.py",
        "evidence/ffmpeg-image-sequence.txt",
        "evidence/artifact_spec.py",
        "evidence/manifest.schema.json",
        "evidence/validate_manifest.py",
        "evidence/finalize_manifest.py",
        "evidence/run_final_lint.py",
        "evidence/lint-summary.json",
        "evidence/run_privacy_scan.py",
        "evidence/privacy-scan.json",
        "evidence/test_manifest_validator.py",
        "snapshots/frame-00-at-5s.png",
        "snapshots/frame-01-at-18s.png",
        "snapshots/frame-02-at-33s.png",
        "snapshots/frame-03-at-49s.png",
        "snapshots/frame-04-at-62s.png",
        "snapshots/frame-05-at-70s.png",
        "snapshots/frame-06-at-84s.png"
      ],
      "properties": {
        "DESIGN.md": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "SCRIPT.md": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "STORYBOARD.md": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "index.html": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "subtitles.srt": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "silent-aac.m4a": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "renders/reference-runtime-evidence.mp4": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/meta.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/extracted/animations.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/extracted/design-styles.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/extracted/fonts-manifest.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/extracted/page.html": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/extracted/tokens.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/extracted/visible-text.txt": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/screenshots/full-page.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "capture/screenshots/scroll-000.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/action-ledger.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/network-ledger.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/dom-states.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/capture_sequence.py": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/ffmpeg-image-sequence.txt": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/artifact_spec.py": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/manifest.schema.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/validate_manifest.py": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/finalize_manifest.py": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/run_final_lint.py": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/lint-summary.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/run_privacy_scan.py": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/privacy-scan.json": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/test_manifest_validator.py": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-00-at-5s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-01-at-18s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-02-at-33s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-03-at-49s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-04-at-62s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-05-at-70s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-06-at-84s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "ffprobe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "programs", "stream_groups", "streams"],
      "properties": {
        "format": {
          "const": {
            "duration": "92.000000",
            "format_name": "mov,mp4,m4a,3gp,3g2,mj2"
          }
        },
        "programs": {"const": []},
        "stream_groups": {"const": []},
        "streams": {
          "const": [
            {
              "codec_name": "h264",
              "codec_type": "video",
              "height": 1080,
              "index": 0,
              "pix_fmt": "yuv420p",
              "r_frame_rate": "30/1",
              "width": 1920
            },
            {
              "channels": 2,
              "codec_name": "aac",
              "codec_type": "audio",
              "index": 1,
              "r_frame_rate": "0/0",
              "sample_rate": "48000"
            }
          ]
        }
      }
    },
    "keyframe_probes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_seconds", "nearest_frame_seconds", "key_frame", "pict_type", "within_one_frame"],
        "properties": {
          "target_seconds": {"type": "number", "enum": [0, 15, 30, 42, 60, 72, 89]},
          "nearest_frame_seconds": {"type": "number"},
          "key_frame": {"const": 1},
          "pict_type": {"const": "I"},
          "within_one_frame": {"const": true}
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_11_of_11", "calculation_60000", "evaluation_scores", "legal_accuracy", "worker_llm_evaluation"],
      "properties": {
        "benchmark_11_of_11": {"const": "STRUCTURE_COMPLETE_ONLY"},
        "calculation_60000": {"const": "PUBLIC_SYNTHETIC_REFERENCE_VALUE_NOT_LEGAL_CONCLUSION"},
        "evaluation_scores": {"type": "null"},
        "legal_accuracy": {"const": "UNKNOWN"},
        "worker_llm_evaluation": {"const": "UNKNOWN"}
      }
    },
    "audio": {"const": "silent-aac.m4a"},
    "audio_role": {"const": "AAC_PLACEHOLDER_SILENCE_NOT_NARRATION"},
    "capture": {"const": "capture/"},
    "classification": {"const": "PUBLIC_SYNTHETIC"},
    "external_side_effects_enabled": {"const": false},
    "faststart": {"const": true},
    "fps": {"const": 30},
    "ledgers": {"const": ["evidence/action-ledger.json", "evidence/network-ledger.json", "evidence/dom-states.json"]},
    "lint_summary": {"const": "evidence/lint-summary.json"},
    "llm": {"const": "OFF"},
    "moov_atom_before_mdat": {"const": true},
    "network_policy": {"const": "capture client uses direct http.client connections to 127.0.0.1/localhost only; reject all other targets before socket creation; no proxy env and no redirects"},
    "pixel_format": {"const": "yuv420p"},
    "readyWorkers": {"const": 0},
    "render_input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "render_input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshots/frame-00-at-5s.png",
        "snapshots/frame-01-at-18s.png",
        "snapshots/frame-02-at-33s.png",
        "snapshots/frame-03-at-49s.png",
        "snapshots/frame-04-at-62s.png",
        "snapshots/frame-05-at-70s.png",
        "snapshots/frame-06-at-84s.png",
        "silent-aac.m4a",
        "evidence/ffmpeg-image-sequence.txt"
      ],
      "properties": {
        "snapshots/frame-00-at-5s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-01-at-18s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-02-at-33s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-03-at-49s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-04-at-62s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-05-at-70s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "snapshots/frame-06-at-84s.png": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "silent-aac.m4a": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence/ffmpeg-image-sequence.txt": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "render_method": {"const": "FFMPEG_FROM_HYPERFRAMES_SNAPSHOTS"},
    "resolution": {"const": "1920x1080"},
    "sequence": {"const": ["PREPARE", "409_FAIL_CLOSED", "LOCAL_DEMO", "PACKAGE", "VERIFY", "11/11_BENCHMARK"]},
    "source_url": {"const": "http://127.0.0.1:8765"},
    "subtitles": {"const": "subtitles.srt"},
    "video": {"const": "renders/reference-runtime-evidence.mp4"},
    "voiceover_status": {"const": "UNAVAILABLE_LOCAL_TTS"},
    "workers": {"const": "Stopped"}
  }
}
