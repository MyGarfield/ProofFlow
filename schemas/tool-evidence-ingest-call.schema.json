          "type": "string"
        },
        "document_id": {
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_content_base64": {
          "contentEncoding": "base64",
          "title": "Raw Content Base64",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "media_type",
        "declared_sha256",
        "raw_content_base64"
      ],
      "title": "EvidenceIngestToolArguments",
      "type": "object"
    },
    "EvidenceIngestToolContext": {
      "additionalProperties": false,
      "properties": {
