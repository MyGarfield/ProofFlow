          "const": "AGENT",
          "default": "AGENT",
          "title": "Actor Kind",
          "type": "string"
        },
        "caller_identity": {
          "const": "PF-A2",
          "default": "PF-A2",
          "title": "Caller Identity",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "expected_state_version": {
