{
  "$defs": {
    "ApprovalDecision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REVISE"
      ],
      "title": "ApprovalDecision",
      "type": "string"
    },
    "ArtifactMeta": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/DataClassification",
          "default": "PUBLIC_SYNTHETIC"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "producer_identity": {
          "minLength": 1,
          "title": "Producer Identity",
          "type": "string"
        },
        "schema_version": {
          "default": "proofflow.dev/v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "tenant_id",
        "case_id",
        "producer_identity",
        "trace_id",
        "created_at"
      ],
      "title": "ArtifactMeta",
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "PUBLIC_SYNTHETIC",
        "INTERNAL",
        "RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_method": {
      "default": "LOCAL_DEMO",
      "title": "Approval Method",
      "type": "string"
    },
    "approved_artifact_hash": {
      "title": "Approved Artifact Hash",
      "type": "string"
    },
    "approver_id": {
      "title": "Approver Id",
      "type": "string"
    },
    "approver_role": {
      "title": "Approver Role",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/ApprovalDecision"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/ArtifactMeta"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "request_id",
    "decision",
    "approver_id",
    "approver_role",
    "reason",
    "approved_artifact_hash",
    "decided_at",
    "expires_at"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}
