{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyGarfield/ProofFlow/schemas/semifinal-submission-manifest.schema.json",
  "title": "ProofFlow GOAI semifinal single ZIP manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_type", "artifact_status", "project", "track",
    "source_commit", "repository_url", "demo_url", "official", "submission_fields",
    "limits", "required_components", "context_mapping", "gate_evidence", "gate", "artifact_inventory",
    "portal_receipt", "selection_claim", "integrity", "build"
  ],
  "properties": {
    "schema_version": {"const": "proofflow.goai.semifinal.manifest/v1"},
    "manifest_type": {"const": "single_semifinal_zip"},
    "artifact_status": {"enum": ["CANDIDATE_NOT_SUBMIT_READY", "PRE_SUBMIT_READY", "SUBMITTED_RECEIPT_VERIFIED"]},
    "project": {"type": "string", "minLength": 1},
    "track": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "repository_url": {"$ref": "#/$defs/publicUrl"},
    "demo_url": {"anyOf": [{"$ref": "#/$defs/publicUrl"}, {"type": "null"}]},
    "official": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_url", "handbook_url", "site_config_url", "submission_url"],
      "properties": {
        "track_url": {"$ref": "#/$defs/officialUrl"},
        "handbook_url": {"$ref": "#/$defs/officialUrl"},
        "site_config_url": {"$ref": "#/$defs/officialUrl"},
        "submission_url": {"$ref": "#/$defs/officialUrl"},
        "snapshot": {
          "type": "object", "additionalProperties": false,
          "required": ["opens_at", "closes_at", "zip_max_mib", "cumulative_max_mib", "max_attempts_per_stage", "last_successful_attempt_is_review_version", "preliminary_rejection_locks_stage", "required_fields", "zip_contents", "independent_infra_mp4_upload_slot"],
          "properties": {
            "opens_at": {"type": "string", "format": "date-time"},
            "closes_at": {"type": "string", "format": "date-time"},
            "zip_max_mib": {"const": 1200},
            "cumulative_max_mib": {"const": 3600},
            "max_attempts_per_stage": {"const": 3},
            "last_successful_attempt_is_review_version": {"const": true},
            "preliminary_rejection_locks_stage": {"const": true},
            "required_fields": {"type": "array", "minItems": 4},
            "zip_contents": {"type": "array", "minItems": 3},
            "independent_infra_mp4_upload_slot": {"const": false}
          }
        }
      }
    },
    "submission_fields": {
      "type": "array", "const": ["作品名", "代码仓库URL", "Demo URL", "ZIP"]
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["zip_max_bytes", "cumulative_max_bytes", "max_attempts_per_stage"],
      "properties": {
        "zip_max_bytes": {"const": 1258291200},
        "cumulative_max_bytes": {"const": 3774873600},
        "max_attempts_per_stage": {"const": 3}
      }
    },
    "required_components": {
      "type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}
    },
    "context_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["options", "selected", "evidence_paths", "evidence_digests"],
      "properties": {
        "options": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "selected": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "evidence_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_digests": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
      }
    },
    "gate_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["eligibility", "real_agent_collaboration", "official_config_recheck"],
      "properties": {
        "eligibility": {"$ref": "#/$defs/evidenceGate"},
        "real_agent_collaboration": {
          "type": "object", "additionalProperties": false,
          "required": ["evidence_refs", "counts"],
          "properties": {
            "evidence_refs": {"$ref": "#/$defs/evidenceGate/properties/evidence_refs"},
            "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["worker_execution", "task_event", "matrix_event", "mcp_receipt", "skill_receipt", "trace", "human_gate_receipt"],
                  "properties": {
                    "worker_execution": {"type": "integer", "minimum": 0},
                    "task_event": {"type": "integer", "minimum": 0},
                    "matrix_event": {"type": "integer", "minimum": 0},
                    "mcp_receipt": {"type": "integer", "minimum": 0},
                    "skill_receipt": {"type": "integer", "minimum": 0},
                    "trace": {"type": "integer", "minimum": 0},
                    "human_gate_receipt": {"type": "integer", "minimum": 0}
                  }
            }
          }
        },
        "official_config_recheck": {
          "type": "object", "additionalProperties": false,
          "required": ["observed_at", "max_age_hours"],
          "properties": {"observed_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}, "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 24}}
        }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reasons", "warnings"],
      "properties": {
        "status": {"enum": ["CANDIDATE_NOT_SUBMIT_READY", "PRE_SUBMIT_READY", "SUBMITTED_RECEIPT_VERIFIED"]},
        "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "artifact_inventory": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "category", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*(?:^|/)(?:private|\\.git|\\.venv|__pycache__|\\.pytest_cache|\\.mypy_cache|\\.ruff_cache)(?:/|$)).+"},
          "category": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"}
        }
      }
    },
    "portal_receipt": {"type": "null"},
    "selection_claim": {"const": false},
    "integrity": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "subject_binding_sha256", "attestation", "signature"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "subject_binding_sha256": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
        "attestation": {"const": "NOT_PROVIDED"},
        "signature": {"const": "NOT_PROVIDED"}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "reproducible", "timestamp", "source_root"],
      "properties": {
        "tool": {"const": "scripts.semifinal_submission"},
        "reproducible": {"const": true},
        "timestamp": {"type": "null"},
        "source_root": {"const": "."}
      }
    }
  },
  "$defs": {
    "publicUrl": {
      "type": "string",
      "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$",
      "not": {"pattern": "(?:@|localhost|127\\.0\\.0\\.1|[?#])"}
    },
    "officialUrl": {
      "type": "string",
      "pattern": "^https://[^/\\s]+(?:/[^\\s]*)?$",
      "not": {"pattern": "(?:@|localhost|127\\.0\\.0\\.1|#)"}
    },
    "evidenceGate": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_refs"],
      "properties": {"evidence_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}}}
    }
  }
}
