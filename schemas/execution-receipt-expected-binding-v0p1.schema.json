                    "pattern": "^[Dd][Aa][Tt][Aa]:"
                  },
                  {
                    "pattern": "^[Uu][Rr][Nn]:"
                  }
                ]
              }
            }
          ],
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type"
      ],
      "title": "ArtifactObservation",
      "type": "object"
    },
