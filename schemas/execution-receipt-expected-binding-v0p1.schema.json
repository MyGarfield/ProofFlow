    "TraceObservation": {
      "additionalProperties": false,
      "properties": {
        "conventions_revision": {
          "const": "proofflow.agent-proof/v0.1",
          "title": "Conventions Revision",
          "type": "string"
        },
        "linked_span_ids": {
          "default": [],
          "items": {
            "allOf": [
              {
                "not": {
                  "const": "0000000000000000"
                }
              }
            ],
            "type": "string"
          },
          "maxItems": 64,
          "title": "Linked Span Ids",
          "type": "array",
          "uniqueItems": true
        },
        "observer_evidence_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Observer Evidence Sha256",
          "type": "string"
        },
        "otel_schema_uri": {
          "const": "https://opentelemetry.io/schemas/1.39.0",
          "title": "Otel Schema Uri",
          "type": "string"
        },
        "parent_span_id": {
          "allOf": [
            {
              "not": {
                "const": "0000000000000000"
              }
            }
          ],
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "allOf": [
            {
              "not": {
                "const": "0000000000000000"
              }
            }
          ],
          "pattern": "^[0-9a-f]{16}$",
          "title": "Span Id",
          "type": "string"
        },
        "trace_id": {
          "allOf": [
            {
              "not": {
                "const": "00000000000000000000000000000000"
              }
            }
          ],
          "pattern": "^[0-9a-f]{32}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "span_id",
        "otel_schema_uri",
        "conventions_revision",
        "observer_evidence_sha256"
      ],
      "title": "TraceObservation",
      "type": "object",
      "x-proofflow-runtime-invariants": [
        "parent_span_id and linked_span_ids never equal span_id"
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "binding_version": {
      "const": "proofflow.execution-receipt-expected/v0.1",
      "title": "Binding Version",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "title": "Case Id",
      "type": "string"
    },
    "certificate_ref": {
      "$ref": "#/$defs/ActionCertificateReference"
    },
    "effect_intent_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Effect Intent Sha256",
      "type": "string"
    },
    "effect_target": {
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "pattern": "://"
              },
              {
                "pattern": "^[Ff][Ii][Ll][Ee]:"
              },
              {
                "pattern": "^[Dd][Aa][Tt][Aa]:"
              },
              {
                "pattern": "^[Uu][Rr][Nn]:"
              }
            ]
          }
        }
      ],
      "maxLength": 512,
      "minLength": 1,
      "title": "Effect Target",
      "type": "string"
    },
    "effect_type": {
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "pattern": "://"
              },
              {
                "pattern": "^[Ff][Ii][Ll][Ee]:"
              },
              {
                "pattern": "^[Dd][Aa][Tt][Aa]:"
              },
              {
                "pattern": "^[Uu][Rr][Nn]:"
              }
            ]
          }
        }
      ],
      "maxLength": 128,
      "minLength": 1,
      "title": "Effect Type",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "executor_workload": {
      "$ref": "#/$defs/PrincipalBinding"
    },
    "executor_workload_key_fingerprints": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Executor Workload Key Fingerprints",
      "type": "array",
      "uniqueItems": true
    },
    "human_principal": {
      "$ref": "#/$defs/PrincipalBinding"
    },
    "human_principal_key_fingerprints": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Human Principal Key Fingerprints",
      "type": "array",
      "uniqueItems": true
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/ArtifactObservation"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Inputs",
      "type": "array",
      "uniqueItems": true
    },
    "operation": {
      "discriminator": {
        "mapping": {
          "SKILL": "#/$defs/SkillOperationObservation",
          "TOOL": "#/$defs/ToolOperationObservation"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ToolOperationObservation"
        },
        {
          "$ref": "#/$defs/SkillOperationObservation"
        }
      ],
      "title": "Operation"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/ArtifactObservation"
      },
      "maxItems": 128,
      "title": "Outputs",
      "type": "array",
      "uniqueItems": true
    },
    "protocol": {
      "discriminator": {
        "mapping": {
          "A2A": "#/$defs/A2aProtocolObservation",
          "LOCAL": "#/$defs/LocalProtocolObservation",
          "MCP": "#/$defs/McpProtocolObservation"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LocalProtocolObservation"
        },
        {
          "$ref": "#/$defs/McpProtocolObservation"
        },
        {
          "$ref": "#/$defs/A2aProtocolObservation"
        }
      ],
      "title": "Protocol"
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeObservation"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "trace": {
      "$ref": "#/$defs/TraceObservation"
    }
  },
  "required": [
    "binding_version",
    "certificate_ref",
    "tenant_id",
    "case_id",
    "execution_id",
    "task_id",
    "attempt_id",
    "attempt_number",
    "human_principal",
    "executor_workload",
    "executor_workload_key_fingerprints",
    "human_principal_key_fingerprints",
    "runtime",
    "protocol",
    "trace",
    "inputs",
    "outputs",
    "operation",
    "effect_type",
    "effect_target",
    "effect_intent_sha256",
    "idempotency_key"
  ],
  "title": "ExpectedExecutionBinding",
  "type": "object",
  "x-proofflow-runtime-invariants": [
    "input and output artifact IDs are unique within each direction and disjoint"
  ]
}
