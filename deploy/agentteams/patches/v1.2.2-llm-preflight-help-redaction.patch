+func TestLLMPreflightHelpDoesNotExposeAPIKeyFromEnv(t *testing.T) {
+	const sentinel = "sentinel-help-secret"
+	t.Setenv("AGENTTEAMS_LLM_API_KEY", sentinel)
+
+	cmd := llmPreflightCmd()
+	var output bytes.Buffer
+	cmd.SetOut(&output)
+	cmd.SetErr(&output)
+	cmd.SetArgs([]string{"--help"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatalf("execute help: %v", err)
+	}
+	if strings.Contains(output.String(), sentinel) {
+		t.Fatal("help output leaked the environment API key")
+	}
+	if flag := cmd.Flags().Lookup("api-key"); flag == nil || strings.Contains(flag.DefValue, sentinel) {
+		t.Fatal("api-key flag default contains the environment API key")
+	}
+}
+
+func TestLLMPreflightCommandUsesAPIKeyFromEnvAtRunTime(t *testing.T) {
+	const apiKey = "sentinel-runtime-env-key"
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if got := r.Header.Get("Authorization"); got != "Bearer "+apiKey {
+			t.Fatalf("Authorization header did not use the environment key")
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	t.Setenv("AGENTTEAMS_LLM_PROVIDER", "custom")
+	t.Setenv("AGENTTEAMS_LLM_API_KEY", apiKey)
+	t.Setenv("AGENTTEAMS_OPENAI_BASE_URL", srv.URL+"/v1")
+	t.Setenv("AGENTTEAMS_DEFAULT_MODEL", "test-model")
+	cmd := llmPreflightCmd()
+	cmd.SetArgs([]string{"--retries", "0"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatalf("execute preflight: %v", err)
+	}
+}
+
+func TestLLMPreflightCommandFlagOverridesEnvironmentAPIKey(t *testing.T) {
+	const envKey = "sentinel-env-key"
+	const flagKey = "sentinel-flag-key"
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if got := r.Header.Get("Authorization"); got != "Bearer "+flagKey {
+			t.Fatalf("Authorization header did not use the flag key")
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	t.Setenv("AGENTTEAMS_LLM_PROVIDER", "custom")
+	t.Setenv("AGENTTEAMS_LLM_API_KEY", envKey)
+	t.Setenv("AGENTTEAMS_OPENAI_BASE_URL", srv.URL+"/v1")
+	t.Setenv("AGENTTEAMS_DEFAULT_MODEL", "test-model")
+	cmd := llmPreflightCmd()
+	cmd.SetArgs([]string{"--api-key", flagKey, "--retries", "0"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatalf("execute preflight: %v", err)
+	}
+}
