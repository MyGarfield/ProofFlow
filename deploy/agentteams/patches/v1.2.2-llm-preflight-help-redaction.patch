+func assertCommandTreeDoesNotContain(t *testing.T, root *cobra.Command, sentinel string) {
+	t.Helper()
+	var visit func(*cobra.Command)
+	visit = func(cmd *cobra.Command) {
+		for _, text := range []string{cmd.Use, cmd.Short, cmd.Long, cmd.Example} {
+			if strings.Contains(text, sentinel) {
+				t.Fatalf("command metadata leaked sentinel: %q", text)
+			}
+		}
+		cmd.Flags().VisitAll(func(flag *pflag.Flag) {
+			for _, text := range []string{flag.DefValue, flag.Usage, flag.Value.String()} {
+				if strings.Contains(text, sentinel) {
+					t.Fatalf("flag %s leaked sentinel: %q", flag.Name, text)
+				}
+			}
+		})
+		for _, child := range cmd.Commands() {
+			visit(child)
+		}
+	}
+	visit(root)
+}
