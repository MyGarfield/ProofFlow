+func TestLLMPreflightHelpDoesNotExposeAPIKeyFromEnv(t *testing.T) {
+	const sentinel = "sentinel-help-secret"
+	t.Setenv("AGENTTEAMS_LLM_API_KEY", sentinel)
+
+	cmd := llmPreflightCmd()
+	assertCommandTreeDoesNotContain(t, cmd, sentinel)
+	var output bytes.Buffer
+	cmd.SetOut(&output)
+	cmd.SetErr(&output)
+	cmd.SetArgs([]string{"--help"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatalf("execute help: %v", err)
+	}
+	if strings.Contains(output.String(), sentinel) {
+		t.Fatal("help output leaked the environment API key")
+	}
+	flag := cmd.Flags().Lookup("api-key")
+	if flag == nil {
+		t.Fatal("api-key flag is missing")
+	}
+	if flag.DefValue != "" || flag.Value.String() != "" {
+		t.Fatalf("api-key flag default=%q value=%q, want both empty", flag.DefValue, flag.Value.String())
+	}
+}
