+func TestLLMPreflightCompletionAndErrorDoNotExposeAPIKey(t *testing.T) {
+	const sentinel = "sentinel-completion-error-secret"
+	t.Setenv("AGENTTEAMS_LLM_API_KEY", sentinel)
+
+	root := newRootCommand("agt")
+	assertCommandTreeDoesNotContain(t, root, sentinel)
+	var bash bytes.Buffer
+	if err := root.GenBashCompletion(&bash); err != nil {
+		t.Fatalf("generate bash completion: %v", err)
+	}
+	if strings.Contains(bash.String(), sentinel) {
+		t.Fatalf("bash completion leaked the environment API key")
+	}
+	var zsh bytes.Buffer
+	if err := root.GenZshCompletion(&zsh); err != nil {
+		t.Fatalf("generate zsh completion: %v", err)
+	}
+	if strings.Contains(zsh.String(), sentinel) {
+		t.Fatalf("zsh completion leaked the environment API key")
+	}
+
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusUnauthorized)
+		_, _ = w.Write([]byte(`{"error":"bad key ` + sentinel + `"}`))
+	}))
+	defer srv.Close()
+	t.Setenv("AGENTTEAMS_LLM_PROVIDER", "custom")
+	t.Setenv("AGENTTEAMS_OPENAI_BASE_URL", srv.URL+"/v1")
+	t.Setenv("AGENTTEAMS_DEFAULT_MODEL", "test-model")
+	t.Setenv("AGENTTEAMS_LLM_PREFLIGHT_STRICT", "true")
+	t.Setenv("AGENTTEAMS_LLM_PREFLIGHT_RETRIES", "0")
+	cmd := llmPreflightCmd()
+	var output bytes.Buffer
+	cmd.SetOut(&output)
+	cmd.SetErr(&output)
+	cmd.SetArgs(nil)
+	if err := cmd.Execute(); err == nil {
+		t.Fatal("execute preflight returned nil, want unauthorized error")
+	} else if strings.Contains(err.Error()+output.String(), sentinel) {
+		t.Fatalf("preflight error leaked the environment API key: %q", err.Error()+output.String())
+	}
+}
