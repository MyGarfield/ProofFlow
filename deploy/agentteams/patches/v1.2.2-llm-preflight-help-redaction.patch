+func TestLLMPreflightCommandUsesAPIKeyFromEnvAtRunTime(t *testing.T) {
+	const apiKey = "sentinel-runtime-env-key"
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if got := r.Header.Get("Authorization"); got != "Bearer "+apiKey {
+			t.Fatalf("Authorization header did not use the environment key")
+		}
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer srv.Close()
+
+	t.Setenv("AGENTTEAMS_LLM_PROVIDER", "custom")
+	t.Setenv("AGENTTEAMS_LLM_API_KEY", apiKey)
+	t.Setenv("AGENTTEAMS_OPENAI_BASE_URL", srv.URL+"/v1")
+	t.Setenv("AGENTTEAMS_DEFAULT_MODEL", "test-model")
+	cmd := llmPreflightCmd()
+	cmd.SetArgs([]string{"--retries", "0"})
+	if err := cmd.Execute(); err != nil {
+		t.Fatalf("execute preflight: %v", err)
+	}
+}
