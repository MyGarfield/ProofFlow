{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofflow.invalid/schemas/reference-video-draft-exit-report-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "decision", "error_code", "image", "checks", "evidence", "integrity"],
  "properties": {
    "schema": {"const": "proofflow.reference-video.draft-exit-report.v1"},
    "status": {"enum": ["UNKNOWN", "PASS", "FAIL"]},
    "decision": {"enum": ["BLOCKED", "READY"]},
    "error_code": {"type": ["string", "null"]},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "child_digest", "config_digest", "toolchain_identity_sha256"],
      "properties": {
        "ref": {"const": "ghcr.io/mygarfield/proofflow-reference-video-verifier@sha256:95098d1231d5cdc8a046e33bad298d5dd85dafaaa1c9a450b82e46f026bf174f"},
        "child_digest": {"const": "sha256:95098d1231d5cdc8a046e33bad298d5dd85dafaaa1c9a450b82e46f026bf174f"},
        "config_digest": {"const": "sha256:5e0b838383ca9050d801fe5a95809106fa428bc98c521cfb15fafd8355286ba9"},
        "toolchain_identity_sha256": {"const": "sha256:f9c4884ce4d3ba693325790329e980c29b40423d1034593e28e8d3231aa82a8f"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "external_publication"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "public_digest_pull"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "publisher_attestation"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "independent_identity"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "video_receipt_schema"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "video_receipt_integrity"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "video_runtime_checks"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "reproducibility_receipt"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "cross_receipt_binding"}}}]}
      ],
      "items": false
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestation_evidence_url", "attestation_result_sha256", "identity_evidence_url", "identity_result_sha256", "video_receipt_file_sha256", "video_receipt_payload_sha256", "reproducibility_receipt_file_sha256", "reproducibility_receipt_payload_sha256"],
      "properties": {
        "attestation_evidence_url": {"type": ["string", "null"], "pattern": "^https://\\S+$"},
        "attestation_result_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "identity_evidence_url": {"type": ["string", "null"], "pattern": "^https://\\S+$"},
        "identity_result_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "video_receipt_file_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "video_receipt_payload_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "reproducibility_receipt_file_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "reproducibility_receipt_payload_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "payload_sha256"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json-excluding-integrity"},
        "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {"properties": {"decision": {"const": "READY"}, "error_code": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"enum": ["UNKNOWN", "FAIL"]}}},
      "then": {"properties": {"decision": {"const": "BLOCKED"}, "error_code": {"type": "string"}}}
    }
  ],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "code"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["UNKNOWN", "PASS", "FAIL"]},
        "code": {"type": "string", "pattern": "^[A-Z0-9_]{3,100}$"}
      }
    }
  }
}
